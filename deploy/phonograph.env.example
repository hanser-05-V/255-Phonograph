# Install outside the repository, root:root 0600; replace all empty production inputs.
NODE_ENV=production
PHONOGRAPH_DEPLOYMENT=private-cloud
PHONOGRAPH_HOST=127.0.0.1
PHONOGRAPH_PORT=3001
PHONOGRAPH_DATA_DIR=/var/lib/255-phonograph
# Replace with the actual approved HTTPS origin after filing.
PHONOGRAPH_SITE_ORIGIN=https://phonograph.invalid
# Full SHA of the actually approved deployment commit; empty intentionally fails startup.
PHONOGRAPH_RELEASE_ID=
