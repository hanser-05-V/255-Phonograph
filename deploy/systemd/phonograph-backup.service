[Unit]
Description=255 Phonograph encrypted consistent backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/255-phonograph/current
EnvironmentFile=/etc/255-phonograph/backup.env
RuntimeDirectory=255-phonograph
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=30min
TimeoutStopSec=2min
KillMode=control-group
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/255-phonograph-backup.lock /usr/bin/node /srv/255-phonograph/current/server-dist/server/ops/cli.js backup --config /etc/255-phonograph/backup.json
ExecStopPost=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/255-phonograph-backup.lock /usr/bin/node /srv/255-phonograph/current/server-dist/server/ops/cli.js recover-service --config /etc/255-phonograph/backup.json
SuccessExitStatus=75
NoNewPrivileges=true
ProtectHome=true
