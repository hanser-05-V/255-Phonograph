[Unit]
Description=255 Phonograph local health and capacity report
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/255-phonograph/current
EnvironmentFile=/etc/255-phonograph/backup.env
ExecStart=/opt/255-phonograph/node24/bin/node /srv/255-phonograph/current/server-dist/server/ops/cli.js health --config /etc/255-phonograph/backup.json
UMask=0077
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectHome=true
